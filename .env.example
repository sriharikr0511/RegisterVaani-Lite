# Optional OpenAI-compatible endpoint; without a key the app uses an explicitly labeled local demo extractor.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional local paths/model selection
DATABASE_PATH=backend/data/registervaani.sqlite3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:6007/api
